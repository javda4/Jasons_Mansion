{
  "name": "riviera-mansion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-textures": "node scripts/fetch-textures.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "author:vip": "blender -b --factory-startup --python blender/tools/author_vip.py && blender -b blender/rooms/vip/vip.blend --python blender/tools/vip_sofas.py && blender -b blender/rooms/vip/vip.blend --python blender/tools/vip_fire.py && blender -b blender/rooms/vip/vip.blend --python blender/tools/vip_pack.py",
    "bake": "node scripts/bake.mjs",
    "author:lobby": "blender -b --factory-startup --python blender/tools/author_lobby.py",
    "author:stair_hall": "blender -b --factory-startup --python blender/tools/author_stair_hall.py",
    "fetch-art": "node scripts/fetch-art.mjs",
    "bake:all": "sh scripts/bake-all.sh",
    "make-carpets": "node scripts/make-carpets.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "make-game-textures": "node scripts/make-game-textures.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
